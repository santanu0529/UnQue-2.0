              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login OK (200)\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"a1Token\", j.token);",
                  "pm.collectionVariables.set(\"a1Id\", j.id);"
